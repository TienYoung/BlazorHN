@page "/"
@inject AppStateService AppState
@implements IDisposable

<PageTitle>Hacker News</PageTitle>

@if (AppState.IsWide)
{
    <div class="hn-select-prompt">
        <span>← select a story</span>
    </div>
}
else if (AppState.SelectedStoryId.HasValue)
{
    <ItemComments Id="@AppState.SelectedStoryId.Value" OnClose="@AppState.ClearStory" />
}
else
{
    <StoryList />
}

@code {
    protected override void OnInitialized() => AppState.OnChange += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => AppState.OnChange -= Refresh;
}
