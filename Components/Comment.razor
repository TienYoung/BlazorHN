@using BlazorHN.Models
@using Microsoft.FluentUI.AspNetCore.Components

@if (Item is not null && !Item.Deleted && !Item.Dead)
{
    <div class="comment" style="--depth: @Depth">
        <div class="comment-author">
            <strong>@Item.By</strong>
            <span style="margin-left: 8px;">@Item.PostedAt.ToString("g")</span>
        </div>
        <div class="comment-body">
            @((MarkupString)(Item.Text ?? ""))
        </div>
        @if (_children is not null)
        {
            @foreach (var child in _children)
            {
                <Comment Item="@child" AllItems="@AllItems" Depth="@(Depth + 1)" />
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public HackerNewsItem Item { get; set; } = default!;

    [Parameter, EditorRequired]
    public Dictionary<int, HackerNewsItem> AllItems { get; set; } = default!;

    [Parameter]
    public int Depth { get; set; } = 0;

    private List<HackerNewsItem>? _children;

    protected override void OnParametersSet()
    {
        if (Item.Kids is { Count: > 0 })
        {
            _children = Item.Kids
                .Where(id => AllItems.ContainsKey(id))
                .Select(id => AllItems[id])
                .ToList();
        }
    }
}
