@using BlazorHN.Models
@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager Nav

<FluentCard class="story-card" @onclick="GoToComments">
    <div class="story-header">
        <span class="story-index">@Index.</span>
        <span class="story-title">@((MarkupString)(Item.Title ?? ""))</span>
        @if (Item.HasUrl)
        {
            <a href="@Item.Url" target="_blank" class="story-domain" @onclick:stopPropagation>
                (@GetDomain(Item.Url))
            </a>
        }
    </div>

    <div class="story-meta">
        <span>@Item.Score points</span>
        <span>by @Item.By</span>
        <span>@Item.PostedAt.ToString("g")</span>
        <span>| @Item.Descendants comments</span>
    </div>
</FluentCard>

@code {
    [Parameter, EditorRequired]
    public int Index { get; set; }

    [Parameter, EditorRequired]
    public HackerNewsItem Item { get; set; } = default!;

    private void GoToComments() => Nav.NavigateTo($"item/{Item.Id}");

    private string GetDomain(string? url)
    {
        if (string.IsNullOrEmpty(url)) return string.Empty;
        try
        {
            return new Uri(url).Host.Replace("www.", "");
        }
        catch
        {
            return string.Empty;
        }
    }
}
