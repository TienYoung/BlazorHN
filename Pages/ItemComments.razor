@page "/item/{Id:int}"
@using BlazorHN.Components
@using BlazorHN.Models
@using BlazorHN.Services
@inject IHackerNewsService HnService
@inject NavigationManager Nav

<PageTitle>@(_story?.Title ?? "Comments") | Hacker News</PageTitle>

<div class="hn-header">
    <div class="hn-header-inner">
        <a href="/" class="hn-header-back">&#8249;</a>
        <div class="hn-header-logo">
            <span class="hn-header-wordmark">Hacker News</span>
        </div>
    </div>
</div>

<div class="hn-page">
    @if (_story is null)
    {
        <div class="hn-spinner-center">
            <FluentProgressRing />
        </div>
    }
    else
    {
        <FluentCard class="hn-story-detail-card">
            <div class="hn-story-detail-inner">
                <h1 class="hn-story-detail-title">
                    @if (_story.HasUrl)
                    {
                        <a href="@_story.Url" target="_blank">@_story.Title</a>
                    }
                    else
                    {
                        @_story.Title
                    }
                </h1>
                <div class="hn-story-detail-meta">
                    <span class="hn-detail-score">▲ @_story.Score</span>
                    <span class="meta-sep">·</span>
                    <span>@_story.By</span>
                    <span class="meta-sep">·</span>
                    <span>@_story.PostedAt.ToString("g")</span>
                    <span class="meta-sep">·</span>
                    <span>@_story.Descendants comments</span>
                </div>
            </div>
        </FluentCard>

        @if (_loading)
        {
            <div class="hn-spinner-center">
                <FluentProgressRing />
            </div>
        }
        else if (_topLevelComments is not null && _topLevelComments.Count > 0)
        {
            <div class="hn-comments-header">@_topLevelComments.Count comments</div>
            @foreach (var comment in _topLevelComments)
            {
                <Comment Item="@comment" AllItems="@_allItems" />
            }
        }
        else
        {
            <p class="hn-no-comments">No comments yet.</p>
        }
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private HackerNewsItem? _story;
    private List<HackerNewsItem>? _topLevelComments;
    private Dictionary<int, HackerNewsItem> _allItems = new();
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _story = null;
        _loading = true;
        _allItems = new();
        _topLevelComments = null;

        _story = await HnService.GetItemAsync(Id);
        if (_story?.Kids is { Count: > 0 })
        {
            await LoadCommentsAsync(_story.Kids);
            _topLevelComments = _story.Kids
                .Where(id => _allItems.ContainsKey(id))
                .Select(id => _allItems[id])
                .ToList();
        }
        _loading = false;
    }

    private async Task LoadCommentsAsync(List<int> ids)
    {
        var items = await Task.WhenAll(ids.Select(id => HnService.GetItemAsync(id)));
        var valid = items.Where(i => i is not null).Cast<HackerNewsItem>().ToList();

        foreach (var item in valid)
            _allItems[item.Id] = item;

        var childIds = valid
            .Where(i => i.Kids is { Count: > 0 })
            .SelectMany(i => i.Kids!)
            .Distinct()
            .Where(id => !_allItems.ContainsKey(id))
            .ToList();

        if (childIds.Count > 0)
            await LoadCommentsAsync(childIds);
    }
}
